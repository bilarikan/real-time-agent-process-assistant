# Gemini Enterprise Agent Platform
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-east1
LIVE_MODEL_ID=gemini-live-2.5-flash-native-audio
LIVE_END_OF_SPEECH_SENSITIVITY=END_SENSITIVITY_HIGH

# Local runtime
KNOWLEDGE_BUNDLE_PATH=./knowledge
OKF_TOOL_TOKEN_LIMIT=3000
SESSION_BUDGET_SECONDS=2100
SESSION_BUDGET_TOKENS=1000000
SESSION_BUDGET_TURNS=250
SAVE_LIVE_BLOB=false
# Daily proration basis: 365 (default) or 364
PRORATION_DAY_BASIS=365
# Development only: restart on Python file changes (drops the live session)
SERVER_RELOAD=false
